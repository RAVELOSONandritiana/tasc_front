# Secret de signature des sessions (OBLIGATOIRE en production).
# Generez une valeur longue et aleatoire, par exemple :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si vide ou trop court, l'app genere un secret aleatoire par processus
# (sessions reinitialisees au redemarrage) et emet un avertissement.
SESSION_SECRET=

# Mot de passe du compte administrateur cree automatiquement au premier
# lancement (matricule 666666). Si vide, un mot de passe aleatoire est genere
# et affiche dans les logs au demarrage. Changez-le immediatement apres connexion.
ADMIN_PASSWORD=
