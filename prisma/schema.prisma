generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Annee scolaire active. Une seule annee peut etre active a la fois.
model AnneeScolaire {
  id             String          @id @default(uuid())
  nom            String
  dateCreation   DateTime        @default(now())
  active         Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  classes        Classe[]
  cours          Cours[]
  emploisDuTemps EmploiDuTemps[]
  examens        Examen[]
  inscriptions   Inscription[]
  incidents      Incident[]
  matieres       Matiere[]
  seancesCours   SeanceCours[]
  rapports       Rapport[]

  @@map("annees_scolaires")
}

/// Catalogue des matieres enseignees.
model Matiere {
  id        String         @id @default(uuid())
  nom       String
  couleur   String?
  icone     String?
  imageUrl  String?
  anneeId   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  anneeScolaire AnneeScolaire @relation(fields: [anneeId], references: [id], onDelete: Cascade)
  cours     Cours[]

  @@unique([nom, anneeId])
  @@map("matieres")
}

/// Classe rattachee a une annee scolaire.
model Classe {
  id             String          @id @default(uuid())
  nom            String?
  niveau         Int
  serie          String?
  capacite       Int?
  imageUrl       String?
  anneeId        String
  titulaireId    String?
  elevesCount    Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  anneeScolaire  AnneeScolaire   @relation(fields: [anneeId], references: [id], onDelete: Cascade)
  titulaire      Professeur?     @relation("TitulaireClasse", fields: [titulaireId], references: [id])
  cours          Cours[]
  emploisDuTemps EmploiDuTemps[]
  examens        Examen[]
  inscriptions   Inscription[]

  @@map("classes")
}

/// Inscription d'un eleve dans une classe pour une annee donnee.
model Inscription {
  id              String        @id @default(uuid())
  actif           Boolean       @default(true)
  dateInscription DateTime      @default(now())
  eleveId         String
  classeId        String?
  anneeId         String
  absences        Absence[]
  incidents       Incident[]
  anneeScolaire   AnneeScolaire @relation(fields: [anneeId], references: [id], onDelete: Cascade)
  classe          Classe?       @relation(fields: [classeId], references: [id], onDelete: Cascade)
  eleve           Eleve         @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  notes           Note[]
  retards         Retard[]
  presences       PresenceEleve[]
  rapports        Rapport[]

  @@unique([eleveId, anneeId])
  @@map("inscriptions")
}

/// Cours = matiere enseignee dans une classe par un professeur.
model Cours {
  id            String        @id @default(uuid())
  coefficient   Int           @default(1)
  classeId      String
  matiereId     String
  professeurId  String
  anneeId       String
  participants  String[]
  imageUrl      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  anneeScolaire AnneeScolaire @relation(fields: [anneeId], references: [id], onDelete: Cascade)
  classe        Classe        @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiere       Matiere       @relation(fields: [matiereId], references: [id])
  professeur    Professeur    @relation(fields: [professeurId], references: [id])
  notes         Note[]
  seances       SeanceEDT[]
  seancesCours  SeanceCours[]

  @@map("cours")
}

/// Note / resultat d'un eleve a un cours.
model Note {
  id            String       @id @default(uuid())
  valeur        Float
  coefficient   Int          @default(1)
  date          DateTime     @default(now())
  libelle       String?
  eleveId       String
  inscriptionId String?
  coursId       String
  examenId      String?
  sousExamenId  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  cours         Cours        @relation(fields: [coursId], references: [id], onDelete: Cascade)
  eleve         Eleve        @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  examen        Examen?      @relation(fields: [examenId], references: [id])
  sousExamen     SousExamen?  @relation(fields: [sousExamenId], references: [id])
  inscription   Inscription? @relation(fields: [inscriptionId], references: [id])

  @@index([sousExamenId])
  @@map("notes")
}

/// Sous-examen = epreuve constituant un examen (ex: Devoir 1, Interrogation).
/// Les notes sont saisies par sous-examen, puis moyennees pour l'examen.
model SousExamen {
  id        String   @id @default(uuid())
  nom       String
  examenId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  examen    Examen   @relation(fields: [examenId], references: [id], onDelete: Cascade)
  notes     Note[]

  @@index([examenId])
  @@map("sous_examens")
}

/// Examen = evaluation planifiee pour une classe.
model Examen {
  id            String        @id @default(uuid())
  nom           String
  date          DateTime
  periode       String?
  actif         Boolean       @default(true)
  classeId      String
  anneeId       String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  anneeScolaire AnneeScolaire @relation(fields: [anneeId], references: [id], onDelete: Cascade)
  classe        Classe        @relation(fields: [classeId], references: [id], onDelete: Cascade)
  notes         Note[]
  sousExamens   SousExamen[]

  @@map("examens")
}

/// Personne physique (base partagee).
model Personne {
  id          String       @id @default(uuid())
  name        String
  lastname    String
  domicile    String?
  fokontany   String?
  commune     String?
  phone       String
  email       String       @unique
  imageUrl    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  compte      Compte?
  eleve       Eleve?
  personnel   Personnel?
  professeur  Professeur?
  surveillant Surveillant?

  @@map("personnes")
}

/// Enseignant.
model Professeur {
  id               String   @id @default(uuid())
  personneId       String   @unique
  matiere          String[]
  retards          Int      @default(0)
  absences         Int      @default(0)
  nbCours          Int      @default(0)
  incidents        Int      @default(0)
  notesPositives   Int      @default(0)
  notesNegatives   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  classesTitulaire Classe[] @relation("TitulaireClasse")
  cours            Cours[]
  seancesCours     SeanceCours[]
  personne         Personne @relation(fields: [personneId], references: [id], onDelete: Cascade)

  @@map("professeurs")
}

/// Surveillant.
model Surveillant {
  id             String   @id @default(uuid())
  personneId     String   @unique
  poste          String
  retards        Int      @default(0)
  absences       Int      @default(0)
  nbCours        Int      @default(0)
  incidents      Int      @default(0)
  notesPositives Int      @default(0)
  notesNegatives Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  personne       Personne @relation(fields: [personneId], references: [id], onDelete: Cascade)

  @@map("surveillants")
}

/// Personnel administratif ou technique.
model Personnel {
  id         String   @id @default(uuid())
  personneId String   @unique
  poste      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  personne   Personne @relation(fields: [personneId], references: [id], onDelete: Cascade)

  @@map("personnel")
}

/// Eleve.
model Eleve {
  id              String        @id @default(uuid())
  personneId      String        @unique
  dateNaissance   DateTime
  im              String?
  sexe            String?
  redoublant      Boolean      @default(false)
  cin             String?
  lieuNaissance   String?
  communeNaissance String?
  regionNaissance String?
  provinceNaissance String?
  regionResidence String?
  provinceResidence String?
  photoUrl        String?
  incidentsCount  Int           @default(0)
  notesPositives  Int           @default(0)
  notesNegatives  Int           @default(0)
  coursTermines   Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  nomMere         String?
  nomPere         String?
  nomTuteur       String?
  prenomMere      String?
  prenomPere      String?
  prenomTuteur    String?
  telephoneMere   String?
  telephonePere   String?
  telephoneTuteur String?
  absences        Absence[]
  personne        Personne      @relation(fields: [personneId], references: [id], onDelete: Cascade)
  incidents       Incident[]
  inscriptions    Inscription[]
  notes           Note[]
  retards         Retard[]
  presences       PresenceEleve[]
  rapports        Rapport[]

  @@map("eleves")
}

model Compte {
  id              String       @id @default(uuid())
  matricule       String       @unique
  password        String
  role            RoleCompte
  statut          StatutCompte @default(EN_ATTENTE)
  dateCreation    DateTime     @default(now())
  dateInscription DateTime     @default(now())
  personneId      String       @unique
  activites       Activite[]
  personne        Personne     @relation(fields: [personneId], references: [id], onDelete: Cascade)
  profil          Profil?

  @@map("comptes")
}

model Profil {
  id              String   @id @default(uuid())
  nom             String
  prenom          String
  email           String
  phone           String?
  role            String
  adresse         String?
  bio             String?
  dateInscription DateTime
  photoUrl        String?
  compteId        String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  compte          Compte   @relation(fields: [compteId], references: [id], onDelete: Cascade)

  @@map("profils")
}

/// Historique des actions utilisateur.
model Activite {
  id          String   @id @default(uuid())
  action      String
  description String
  ipAddress   String?
  userAgent   String?
  compteId    String
  createdAt   DateTime @default(now())
  compte      Compte   @relation(fields: [compteId], references: [id], onDelete: Cascade)

  @@map("activites")
}

model Salle {
  id        String      @id @default(uuid())
  num       Int
  nom       String
  capacite  Int
  occupe    Boolean     @default(false)
  imageUrl  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  seances   SeanceEDT[]

  @@map("salles")
}

model EmploiDuTemps {
  id            String        @id @default(uuid())
  classeId      String
  anneeId       String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  anneeScolaire AnneeScolaire @relation(fields: [anneeId], references: [id], onDelete: Cascade)
  classe        Classe        @relation(fields: [classeId], references: [id], onDelete: Cascade)
  seances       SeanceEDT[]

  @@map("emplois_du_temps")
}

model SeanceEDT {
  id         String        @id @default(uuid())
  jour       String
  heureDebut String
  heureFin   String
  edtId      String
  coursId    String
  salleId    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  cours      Cours         @relation(fields: [coursId], references: [id], onDelete: Cascade)
  edt        EmploiDuTemps @relation(fields: [edtId], references: [id], onDelete: Cascade)
  salle      Salle?        @relation(fields: [salleId], references: [id])

  @@map("seances_edt")
}

/// Séance de cours en direct (prise de présence).
model SeanceCours {
  id           String       @id @default(uuid())
  coursId      String
  professeurId String
  anneeId      String
  statut       StatutSeance @default(EN_COURS)
  dateDebut    DateTime     @default(now())
  dateFin      DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  cours        Cours        @relation(fields: [coursId], references: [id], onDelete: Cascade)
  professeur   Professeur   @relation(fields: [professeurId], references: [id])
  anneeScolaire AnneeScolaire @relation(fields: [anneeId], references: [id], onDelete: Cascade)
  presences    PresenceEleve[]

  @@index([coursId, statut])
  @@map("seances_cours")
}

/// Présence d'un élève lors d'une séance de cours.
model PresenceEleve {
  id            String         @id @default(uuid())
  seanceId      String
  eleveId       String
  inscriptionId String?
  statut        StatutPresence @default(PRESENT)
  heureMarquage DateTime       @default(now())
  commentaire   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  seance        SeanceCours    @relation(fields: [seanceId], references: [id], onDelete: Cascade)
  eleve         Eleve          @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  inscription   Inscription?   @relation(fields: [inscriptionId], references: [id])

  @@unique([seanceId, eleveId])
  @@map("presences_eleve")
}

/// Absence d'un eleve.
model Absence {
  id            String       @id @default(uuid())
  date          DateTime     @default(now())
  justifie      Boolean      @default(false)
  motif         String?
  eleveId       String
  inscriptionId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  eleve         Eleve        @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  inscription   Inscription? @relation(fields: [inscriptionId], references: [id])
  rapports      RapportLigne[]

  @@map("absences")
}

/// Retard d'un eleve.
model Retard {
  id            String       @id @default(uuid())
  date          DateTime     @default(now())
  duree         String
  motif         String?
  justifie      Boolean      @default(false)
  eleveId       String
  inscriptionId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  eleve         Eleve        @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  inscription   Inscription? @relation(fields: [inscriptionId], references: [id])
  rapports      RapportLigne[]

  @@map("retards")
}

/// Rapport d'un surveillant concernant un retard ou une absence d'un eleve.
model Rapport {
  id            String        @id @default(uuid())
  type          TypeRapport   @default(RETARD)
  message       String?
  auteur        String
  compteId      String?
  eleveId       String
  inscriptionId String?
  anneeId       String
  date          DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  eleve         Eleve         @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  anneeScolaire AnneeScolaire @relation(fields: [anneeId], references: [id], onDelete: Cascade)
  inscription   Inscription?  @relation(fields: [inscriptionId], references: [id])
  lignes        RapportLigne[]

  @@index([eleveId])
  @@index([anneeId])
  @@map("rapports")
}

/// Ligne d'un rapport : reference un absence ou un retard concret de l'eleve.
model RapportLigne {
  id        String      @id @default(uuid())
  rapportId String
  type      TypeRapport
  eleveId   String
  date      DateTime
  motif     String?
  absenceId String?
  retardId  String?
  createdAt DateTime    @default(now())
  rapport   Rapport     @relation(fields: [rapportId], references: [id], onDelete: Cascade)
  absence   Absence?    @relation(fields: [absenceId], references: [id], onDelete: Cascade)
  retard    Retard?     @relation(fields: [retardId], references: [id], onDelete: Cascade)

  @@index([rapportId])
  @@index([absenceId])
  @@index([retardId])
  @@map("rapport_lignes")
}

/// Incident / actu concernant un eleve.
model Incident {
	id            String       @id @default(uuid())
	type          TypeIncident
	message       String
	auteur        String
	date          DateTime     @default(now())
	eleveId       String
	anneeId       String
	inscriptionId String?
	createdAt     DateTime     @default(now())
	updatedAt     DateTime     @updatedAt
	compteId      String?
	comments      Comment[]
	eleve         Eleve        @relation(fields: [eleveId], references: [id], onDelete: Cascade)
	anneeScolaire AnneeScolaire @relation(fields: [anneeId], references: [id], onDelete: Cascade)
	inscription   Inscription? @relation(fields: [inscriptionId], references: [id])
	reactions     Reaction[]

	@@map("incidents")
}

model Reaction {
	id         String   @id @default(uuid())
	emoji      String
	user       String
	incidentId String
	createdAt  DateTime @default(now())
	incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

	@@map("reactions")
}

model Comment {
	id         String   @id @default(uuid())
	author     String
	authorId   String?
	text       String
	date       DateTime @default(now())
	incidentId String
	parentId   String?
	edited     Boolean  @default(false)
	createdAt  DateTime @default(now())
	incident   Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
	parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
	replies    Comment[] @relation("CommentReplies")

	@@map("comments")
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  description String
  time        String
  read        Boolean  @default(false)
  scope       String   @default("ALL")
  actionType  String?
  matricule   String?
  userId      String?
  createdAt   DateTime @default(now())

  @@map("notifications")
}

/// Fichier media stocke dans PocketBase.
/// On ne stocke que l'URL de reference, pas le fichier binaire.
model Media {
  id        String   @id @default(uuid())
  url       String
  nom       String?
  type      String?
  taille    Int?
  ownerType String?
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("media")
}

enum RoleCompte {
  ADMINISTRATEUR
  ENSEIGNANT
  SURVEILLANT
  PERSONNEL
}

enum StatutCompte {
  EN_ATTENTE
  ACTIF
  BLOQUE
}

enum TypeIncident {
  INFO
  ERREUR
  NOTE
  ABSENT
}

enum TypeRapport {
  RETARD
  ABSENCE
}

enum StatutSeance {
  EN_COURS
  TERMINE
}

enum StatutPresence {
  PRESENT
  ABSENT
  RETARD
}
